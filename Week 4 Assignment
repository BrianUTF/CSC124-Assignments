// Week 4: Multi-Animal Entry System
// Use loops to manage multiple animal entries
// Remove "Internal"

int animalPop= 0;// Counts all the animals on board
int species=0;// Keeps track on how many new species are on baord 
double dailyFood=0;// Tracks to food requirements for all animals on board for a single day
double totalFood=0;// Stores the Total Food for the 40 day voyage
Console.Write("=== Noah's Ark Entry System ===");

bool menu = true ;
while (menu)
{
Console.WriteLine("1. Add Animals ");

Console.WriteLine("2. View Summary");

Console.WriteLine("3. Exit");

Console.WriteLine("Choose 1-3");
string option=Console.ReadLine();
// Only choose between these options (1-3)
switch(option)
{
    case "1":
Console.Write("\nEnter Animal Name: ");// Ex. Lion , Cheetah , Goose , etc

string animalName = Console.ReadLine();
Console.Write($" how many {animalName} are boarding ?"); 
int populationOfBoarding =Convert.ToInt32(Console.ReadLine());
animalPop += populationOfBoarding;
species++;
Console.Write("Enter Food per one Animal a day(Lbs):");// Enter food for a single animal of the species 
double foodPerAnimal = Convert.ToDouble(Console.ReadLine());
Console.WriteLine($"{animalName}(s) added succesfully");
dailyFood= populationOfBoarding * foodPerAnimal;
totalFood += dailyFood * 40;
break;
case "2":
Console.WriteLine("==Showing summary== ");
 Console.WriteLine($"Total Animal Population : {animalPop}");
 Console.WriteLine($"Total Animal Speices:{species}");
 Console.WriteLine($"Total Daily food :{dailyFood}(Lbs)");
 Console.WriteLine($"Food required for the 40 Day Voyage:{totalFood}(Lbs)");
break;
case "3":
menu=false;
break;
default:
Console.WriteLine( "Error - Choose 1-3 only");
break;
}
}
Console.WriteLine("Thank You , GoodBye!");
