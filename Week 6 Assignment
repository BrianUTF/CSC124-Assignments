public class Animal
{
    public string Name {get; set ;}
    private int _count;
    public int Count 
    {
        get {return _count;}
        set 
        {
            if (value > 0 )
            _count = value;
        }
    }
    private double _foodPerDay;
    public double foodPerDay 
    {
        get { return _foodPerDay;}
        set
        {
            if (value > 0)
            _foodPerDay= value;
        }
    }


    public bool isCarnivore {get; set; }

    public string Size {get; set; }

    public Animal(string name , int count , double food ,
    bool Carnivore , string size)
    {
        Name = name ; 
        Count = count; 
        foodPerDay = food ; 
        isCarnivore = Carnivore;
        Size=size;
    }
    public double CalculateDailyFood()
    { 
        return Count * foodPerDay;
    }
    public double CalculateVoyageFood( int voyage)
    {
        return CalculateDailyFood() * voyage;
    }
    public int GetFloorAssignment()
    {
        switch(Size.ToLower())
        {
            case "large":return 1;
            case "medium":return 2;
            case "small" : return 3;
            default:return 0;
        }
    }
    public void DisplayInfo()
    {
        Console.WriteLine($"Animal: {Name}");
        Console.WriteLine($"Animals Count : {Count}");
        Console.WriteLine($"Floor:{GetFloorAssignment()}");
        Console.WriteLine($"Daily Food :{CalculateDailyFood()}");
        if (isCarnivore)
        Console.WriteLine("Warning !!! - Animal inputted is Carnivorous , Seperate housing requiered ");
    }
}
public class FoodSupply
{
    public string FoodType{get; set;}
    public double TotalPounds {get; set;}
    public double DailyUsage{get; set;}
    public FoodSupply(string foodType, double totalPounds, double dailyUsage)
{
FoodType = foodType;
TotalPounds = totalPounds;
DailyUsage = dailyUsage;
}
    public double CalculateDaysRemaining()
    {
        if(DailyUsage<= 0 )
     { 
        return 0;
     }
     return TotalPounds/DailyUsage;
    }
public void AddSupply(double pounds)
{
    TotalPounds+=pounds;
}
public void UseSupply(double pounds)
{
    TotalPounds-= pounds;
    if(TotalPounds<0)
    {
        TotalPounds = 0;
    }
}
public void DisplayFood()
{
    Console.WriteLine($"Food Type : {FoodType}");
    Console.WriteLine($"Total Pounds of Food : {TotalPounds}");
    Console.WriteLine($"Daily Usage :{DailyUsage}");
    Console.WriteLine($"Days Remaining: {CalculateDaysRemaining()}");
}
}
